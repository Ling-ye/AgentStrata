[Unit]
Description=AgentStrata Gateway host %i
Documentation=https://github.com/Ling-ye/AgentStrata
After=default.target

[Service]
Type=simple
# 每个实例的 wsl_home 由 register.sh 写入下面这个 env 文件（含 CCP_WSL_HOME）。
# 这样既支持 ~/ChatCopilot-<id> 约定，也支持 bot.yaml 里自定义 wsl_home。
EnvironmentFile=%h/.config/chatcopilot-console/%i.env
# launcher 用非执行式解析加载 bot runtime env，随后原位 exec Python；因此 systemd
# MainPID 是精确的 ``python -m chatcopilot run --bot ...`` Gateway host。
ExecStart=/usr/bin/env bash ${CCP_WSL_HOME}/deploy/wsl/start.sh --apply-config
Restart=on-failure
RestartSec=5
# Gateway stdout/stderr 与启动异常统一进入当前 unit 的 journald。
StandardOutput=journal
StandardError=journal
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
