[Unit]
Description=AgentStrata 运维控制台后端 (FastAPI + SSE, 127.0.0.1:8910)
Documentation=https://github.com/Ling-ye/AgentStrata
Wants=chatcopilot-evaluation.service
After=default.target chatcopilot-evaluation.service

[Service]
Type=simple
# 控制台原生跑在 WSL 源仓 ~/ChatCopilot；源仓更新后用 deploy_console.sh
# 或控制台自身更新入口重建前端并重启本服务。
WorkingDirectory=%h/ChatCopilot
ExecStart=%h/ChatCopilot/.venv/bin/python -m console.backend
Restart=on-failure
RestartSec=3
# 默认只监听回环；非回环暴露必须由操作者显式覆盖并另行提供访问控制。
Environment=CHATCOPILOT_CONSOLE_HOST=127.0.0.1
Environment=CHATCOPILOT_CONSOLE_PORT=8910
Environment=CHATCOPILOT_EVALUATION_SOCKET=%t/agentstrata-evaluation/service.sock
Environment=PYTHONPATH=%h/ChatCopilot/src
StandardOutput=journal
StandardError=journal
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=default.target
