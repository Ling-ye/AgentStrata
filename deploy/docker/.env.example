# Docker external services configuration.
# Copy to .env and edit before running docker compose up.

# xiaohongshu-mcp
XHS_MCP_PORT=18060
# XHS_PROXY=http://your_user:your_password@proxy:port

# tavily-mcp (get free key at https://tavily.com)
TAVILY_API_KEY=
# Optional quota-check cache tuning. Defaults shown below.
TAVILY_USAGE_AVAILABLE_TTL_SECONDS=300
TAVILY_USAGE_EXHAUSTED_TTL_SECONDS=1800
TAVILY_USAGE_FAILURE_TTL_SECONDS=30
TAVILY_USAGE_TIMEOUT_SECONDS=5
