# 模型及推理参数在 Console 模型配置页维护。所有服务引用同一文件。
export AGENTSTRATA_LLM_CONFIG="$HOME/.config/agentstrata/llm.json"
# 首次尚未保存时读取同目录 llm.defaults.json；保存后不再使用默认文件。
# Copy to the service user's ~/.config/agentstrata/evaluation.env (mode 0600).
# These settings belong to Evaluation, independently of every tested Bot.
CHATCOPILOT_EVALUATION_JUDGE_API_KEY=

# Optional benchmark environments; preparing them never happens on page load.
CHATCOPILOT_SWEBENCH_DATA_PATH=
CHATCOPILOT_SWEBENCH_MAX_CASES=
CHATCOPILOT_AGENTBENCH_DATA_PATH=
CHATCOPILOT_AGENTBENCH_CONTROLLER_URL=
