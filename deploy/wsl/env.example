# AgentStrata WSL2 instance environment example
#
# Prefer the bot-local template for normal deployment:
#   cp bots/lingye-copilot-qq/local.env.example bots/lingye-copilot-qq/local.env
#   chmod 600 bots/lingye-copilot-qq/local.env
#
# This file remains available for `install_wsl_env.sh --init-env`. Copy it to a
# private location, replace every placeholder, and keep the result mode 0600.

export CHATCOPILOT_INSTANCE_ID="lingye-copilot-qq"
export CHATCOPILOT_HOME="$HOME/AgentStrata"
export CHATCOPILOT_WORKSPACE_ROOT="$HOME/agentstrata-workspaces/${CHATCOPILOT_INSTANCE_ID}"
export WORKSPACE_ROOT="$CHATCOPILOT_WORKSPACE_ROOT"
export CHATCOPILOT_LOG_DIR="$HOME/agentstrata-logs/${CHATCOPILOT_INSTANCE_ID}"
export CHATCOPILOT_CC_HOME="$HOME/.agentstrata-runtime/${CHATCOPILOT_INSTANCE_ID}"
export CHATCOPILOT_CC_PROJECT_NAME="agentstrata-${CHATCOPILOT_INSTANCE_ID}"

# LLM configuration. The prefix matches bots/lingye-copilot-qq/bot.yaml.
export CHATCOPILOT_LINGYE_API_KEY="<llm-api-key>"
# export CHATCOPILOT_LINGYE_BASE_URL="https://api.example.com/v1"
# export CHATCOPILOT_LINGYE_MODEL="provider/model"

# QQ / OneBot v11. Keep the gateway on loopback and use a dedicated account.
export QQ_ACCOUNT="<qq-number>"
export QQ_WS_URL="ws://127.0.0.1:3001"
export QQ_ACCESS_TOKEN="<32-to-128-url-safe-characters>"
export QQ_ALLOW_FROM="*"
export QQ_REQUIRE_AT_IN_GROUP="true"

# Optional generic HTTP route registry. Route modules are explicit imports.
# export CHATCOPILOT_HTTP_ROUTE_MODULES="package.module"
# export CHATCOPILOT_HTTP_API_HOST="127.0.0.1"
# export CHATCOPILOT_HTTP_API_PORT="8787"
# export CHATCOPILOT_HTTP_API_TOKEN="<machine-api-token>"

# Optional search and integration credentials.
# export TAVILY_API_KEY="<tavily-api-key>"
# export GITHUB_MCP_AUTHORIZATION="<github-token>"
