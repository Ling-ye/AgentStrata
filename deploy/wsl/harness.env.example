# Optional operator-owned file: ~/.config/agentstrata/harness.env, mode 0600.
# Independent of Bot and Evaluation service configuration. No shell execution.
# Values may start with ~, $HOME or ${HOME}. Process environment overrides this file.
CHATCOPILOT_HARNESS_MODEL=
CHATCOPILOT_HARNESS_ROOT=
# Absolute path to a native Linux Codex binary, not a Node wrapper.
CHATCOPILOT_CODEX_BIN=
# Existing dedicated credential root with an authenticated worker lane.
CHATCOPILOT_CODEX_BOT_HOME=
# Optional; leave empty for the normal same-user Evaluation socket.
CHATCOPILOT_EVALUATION_SOCKET=
