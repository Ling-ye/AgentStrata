@@ -0,0 +1,45 @@
+import { useEffect, useRef, useState } from 'react';
+import { useAiState } from '@/context/ai-state-context';
+import { useVAD } from '@/context/vad-context';
+import { useWebSocket } from '@/context/websocket-context';
+import { desktop, lockDesktop, setDesktopVisible } from '@/services/desktop-state';
+
+export default function AgentStrataDesktop() {
+  const { aiState } = useAiState();
+  const { stopMic, micOn, setAutoStartMicOn, setAutoStartMicOnConvEnd, setAutoStopMic } = useVAD();
+  const { wsState, reconnect } = useWebSocket();
+  const state = useRef({ aiState, micOn, wsState });
+  state.current = { aiState, micOn, wsState };
+  const [locked, setLocked] = useState(false);
+  useEffect(() => {
+    if (!desktop) return undefined;
+    setAutoStartMicOn(false); setAutoStartMicOnConvEnd(false); setAutoStopMic(true); stopMic();
+    const visibility = desktop.onVisibility((visible: boolean) => {
+      setDesktopVisible(visible);
+      if (!visible) stopMic();
+    });
+    const prepare = desktop.onPrepare(() => {
+      const current = state.current;
+      if (current.micOn || !['idle', 'interrupted', 'waiting'].includes(current.aiState) || current.wsState !== 'OPEN') return false;
+      lockDesktop(true); setLocked(true); stopMic();
+      return true;
+    });
+    const resume = desktop.onResume(() => { lockDesktop(false); setLocked(false); });
+    return () => { visibility(); prepare(); resume(); lockDesktop(false); };
+  }, []);
+  useEffect(() => {
+    if (desktop && wsState === 'OPEN') desktop.ready();
+  }, [wsState]);
+  useEffect(() => {
+    if (!desktop || locked || wsState !== 'CLOSED') return undefined;
+    const timer = setTimeout(reconnect, 3000);
+    return () => clearTimeout(timer);
+  }, [locked, wsState, reconnect]);
+  if (!desktop) return null;
+  if (locked) return <div role="status" style={{ position: 'fixed', inset: 0, zIndex: 2147483647,
+    background: '#18202bee', color: 'white', display: 'grid', placeItems: 'center' }}>正在切换角色，请稍候…</div>;
+  return <button type="button" onClick={() => desktop.openManager()} style={{ position: 'fixed', top: 38,
+    right: 12, zIndex: 1000, borderRadius: 8, padding: '6px 12px', color: '#ecf0f6', background: '#28394d',
+    WebkitAppRegion: 'no-drag' } as React.CSSProperties} onMouseEnter={() => (window.api as any)?.updateComponentHover('characters', true)}
+    onMouseLeave={() => (window.api as any)?.updateComponentHover('characters', false)}>我的角色</button>;
+}
