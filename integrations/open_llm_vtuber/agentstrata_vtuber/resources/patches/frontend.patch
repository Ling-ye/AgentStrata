diff --git a/src/renderer/src/components/electron/agentstrata-desktop.tsx b/src/renderer/src/components/electron/agentstrata-desktop.tsx
new file mode 100644
--- /dev/null
+++ b/src/renderer/src/components/electron/agentstrata-desktop.tsx
@@ -0,0 +1,49 @@
+import { useEffect, useRef, useState } from 'react';
+import { useAiState } from '@/context/ai-state-context';
+import { useVAD } from '@/context/vad-context';
+import { useWebSocket } from '@/context/websocket-context';
+import { useMode } from '@/context/mode-context';
+import { desktop, lockDesktop, setDesktopVisible } from '@/services/desktop-state';
+
+export default function AgentStrataDesktop() {
+  const { aiState } = useAiState();
+  const { mode } = useMode();
+  const { stopMic, micOn, setAutoStartMicOn, setAutoStartMicOnConvEnd, setAutoStopMic } = useVAD();
+  const { wsState, reconnect } = useWebSocket();
+  const state = useRef({ aiState, micOn, wsState });
+  state.current = { aiState, micOn, wsState };
+  const [locked, setLocked] = useState(false);
+  useEffect(() => {
+    if (!desktop) return undefined;
+    setAutoStartMicOn(false); setAutoStartMicOnConvEnd(false); setAutoStopMic(true); stopMic();
+    const visibility = desktop.onVisibility((visible: boolean) => {
+      setDesktopVisible(visible);
+      if (!visible) stopMic();
+    });
+    const prepare = desktop.onPrepare(() => {
+      const current = state.current;
+      if (current.micOn || !['idle', 'interrupted', 'waiting'].includes(current.aiState) || current.wsState !== 'OPEN') return false;
+      lockDesktop(true); setLocked(true); stopMic();
+      return true;
+    });
+    const resume = desktop.onResume(() => { lockDesktop(false); setLocked(false); });
+    return () => { visibility(); prepare(); resume(); lockDesktop(false); };
+  }, []);
+  useEffect(() => {
+    if (desktop && wsState === 'OPEN') desktop.ready();
+  }, [wsState]);
+  useEffect(() => {
+    if (!desktop || locked || wsState !== 'CLOSED') return undefined;
+    const timer = setTimeout(reconnect, 3000);
+    return () => clearTimeout(timer);
+  }, [locked, wsState, reconnect]);
+  useEffect(() => { desktop?.activity(micOn || !['idle', 'interrupted', 'waiting'].includes(aiState)); }, [aiState, micOn]);
+  if (!desktop) return null;
+  if (locked) return <div role="status" style={{ position: 'fixed', inset: 0, zIndex: 2147483647,
+    background: '#18202bee', color: 'white', display: 'grid', placeItems: 'center' }}>正在切换角色，请稍候…</div>;
+  if (mode === 'pet') return null;
+  return <button type="button" onClick={() => desktop.openManager()} style={{ position: 'fixed', top: 38,
+    right: 12, zIndex: 1000, borderRadius: 8, padding: '6px 12px', color: '#ecf0f6', background: '#28394d',
+    WebkitAppRegion: 'no-drag' } as React.CSSProperties} onMouseEnter={() => (window.api as any)?.updateComponentHover('characters', true)}
+    onMouseLeave={() => (window.api as any)?.updateComponentHover('characters', false)}>我的角色</button>;
+}
diff --git a/src/renderer/src/components/electron/desktop-bubble.tsx b/src/renderer/src/components/electron/desktop-bubble.tsx
new file mode 100644
--- /dev/null
+++ b/src/renderer/src/components/electron/desktop-bubble.tsx
@@ -0,0 +1,72 @@
+import { useEffect, useState } from 'react';
+import { LAppDelegate } from '../../../WebSDK/src/lappdelegate';
+import { desktop } from '@/services/desktop-state';
+
+type Anchor = {x: number; y: number};
+const placed = new WeakSet<object>();
+function bounds() {
+  const adapter = (window as any).getLAppAdapter?.();
+  const model = adapter?.getModel();
+  const canvas = document.getElementById('canvas') as HTMLCanvasElement | null;
+  const view = LAppDelegate.getInstance()?.getView() as any;
+  if (!model?._model || !model._modelMatrix || !canvas || !view?._deviceToScreen) return null;
+  const rect = canvas.getBoundingClientRect();
+  let left = Infinity, top = Infinity, right = -Infinity, bottom = -Infinity;
+  for (let i=0; i<model._model.getDrawableCount(); i++) {
+    if (!model._model.getDrawableDynamicFlagIsVisible(i)) continue;
+    const vertices = model._model.getDrawableVertices(i);
+    for (let j=0; j<vertices.length; j+=2) {
+      const x = rect.left + view._deviceToScreen.invertTransformX(model._modelMatrix.transformX(vertices[j])) * rect.width / canvas.width;
+      const y = rect.top + view._deviceToScreen.invertTransformY(model._modelMatrix.transformY(vertices[j+1])) * rect.height / canvas.height;
+      left=Math.min(left,x); right=Math.max(right,x); top=Math.min(top,y); bottom=Math.max(bottom,y);
+    }
+  }
+  return Number.isFinite(top) && bottom-top>1 ? {adapter,model,canvas,view,left,right,top,bottom} : null;
+}
+export function usePetAnchor(): Anchor {
+  const [anchor,setAnchor]=useState<Anchor>({x:window.innerWidth/2,y:window.innerHeight/2});
+  useEffect(()=>{
+    const tick=()=>{
+      let b=bounds(); if (!b) return;
+      if (desktop && !placed.has(b.model)) {
+        const ratio=Math.min(1,400/(b.bottom-b.top));
+        const scale=b.model._modelMatrix.getScaleX()*ratio;
+        window.dispatchEvent(new CustomEvent('desktop-model-scale',{detail:scale}));
+        b=bounds(); if (!b) return;
+        const rect=b.canvas.getBoundingClientRect(), factor=b.canvas.width/rect.width;
+        const dx=window.innerWidth-64-b.right,dy=window.innerHeight-24-b.bottom;
+        const position=b.adapter.getModelPosition();
+        b.adapter.setModelPosition(position.x+b.view._deviceToScreen.transformX(dx*factor)-b.view._deviceToScreen.transformX(0),
+          position.y+b.view._deviceToScreen.transformY(dy*factor)-b.view._deviceToScreen.transformY(0));
+        placed.add(b.model);
+      }
+      setAnchor({x:Math.max(180,Math.min(window.innerWidth-180,(b.left+b.right)/2)),y:Math.max(100,b.top-12)});
+    };
+    const timer=setInterval(tick,100);return()=>clearInterval(timer);
+  },[]);
+  return anchor;
+}
+export function DesktopBubble({anchor,text,aiState}:{anchor:Anchor;text:string;aiState:string}) {
+  const [notice,setNotice]=useState('');
+  const [visible,setVisible]=useState(false);
+  const [watching,setWatching]=useState(false);
+  useEffect(()=>{if(text){setNotice(text);setVisible(true);}},[text]);
+  useEffect(()=>{
+    const receive=(event:Event)=>{setNotice((event as CustomEvent<string>).detail);setVisible(true);};
+    window.addEventListener('desktop-notice',receive);
+    const unsubscribe=desktop?.onPerception(setWatching);
+    return()=>{window.removeEventListener('desktop-notice',receive);unsubscribe?.();};
+  },[]);
+  useEffect(()=>{
+    if (!visible || !['idle','interrupted','waiting'].includes(aiState)) return undefined;
+    const timer=setTimeout(()=>setVisible(false),6000); return()=>clearTimeout(timer);
+  },[visible,notice,aiState]);
+  if(!visible&&!watching)return null;
+  return <div style={{position:'fixed',left:anchor.x,top:anchor.y,transform:'translate(-50%,-100%)',zIndex:1000,
+    maxWidth:320,color:'#f8fafc',fontSize:14,lineHeight:1.5,pointerEvents:'auto'}}
+    onMouseEnter={()=>window.api?.updateComponentHover?.('perception',true)}
+    onMouseLeave={()=>window.api?.updateComponentHover?.('perception',false)}>
+    {visible&&<div style={{padding:'12px 16px',borderRadius:18,background:'rgba(24,32,43,.9)',maxHeight:180,overflowY:'auto',whiteSpace:'pre-wrap'}}>{notice}</div>}
+    {watching&&<button onClick={()=>desktop.setPerception(false)} style={{display:'block',margin:'6px auto 0',padding:'3px 10px',borderRadius:12,background:'#245449',color:'white',fontSize:12}}>正在观察主屏 · 暂停</button>}
+  </div>;
+}
