# Generate two different 32-128 character URL-safe credentials locally.
AGENTSTRATA_AVATAR_GATEWAY_TOKEN=
AGENTSTRATA_AVATAR_CONTROL_TOKEN=
# Bearer followed by the same control token, used only by AgentStrata's MCP client.
AGENTSTRATA_AVATAR_CONTROL_AUTH=
# Absolute path of your private adapter JSON configuration.
AGENTSTRATA_VTUBER_CONFIG=
# Full corresponding source for this deployed version.
CHATCOPILOT_SOURCE_URL=
# Optional CLI installation root. Managed installs otherwise use the XDG data directory.
AGENTSTRATA_PLUGINS_ROOT=
CHATCOPILOT_GATEWAY_PORT=18791
# Create the state parent as mode 0700 before starting the Gateway.
CHATCOPILOT_GATEWAY_STATE_ROOT=
CHATCOPILOT_WORKSPACE_ROOT=
# Optional explicit Owner project resource; use only an authorized project root.
CHATCOPILOT_DEV_ROOT=
