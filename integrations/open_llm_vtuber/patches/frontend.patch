diff --git a/src/renderer/src/services/agentstrata-avatar.ts b/src/renderer/src/services/agentstrata-avatar.ts
new file mode 100644
--- /dev/null
+++ b/src/renderer/src/services/agentstrata-avatar.ts
@@ -0,0 +1,51 @@
+import { wsService, MessageEvent } from './websocket-service';
+
+// Adapter-private presentation state. It never changes Gateway execution state.
+let activeRun: string | undefined;
+
+export function setAgentStrataRun(runId: string | undefined): void {
+  activeRun = runId;
+}
+
+export function reportPlayback(playbackId: string, status: string, runId?: string): void {
+  if (!runId && !activeRun) return;
+  wsService.sendMessage({ type: 'agentstrata-playback', playback_id: playbackId,
+    status, run_id: runId ?? activeRun });
+}
+
+export function currentAgentStrataRun(): string | undefined {
+  return activeRun;
+}
+
+export function handleAvatarAction(message: MessageEvent, modelName?: string): void {
+  const respond = (status: 'executed' | 'failed' | 'unknown') => wsService.sendMessage({
+    type: 'agentstrata-avatar-result', request_id: message.request_id, status,
+  });
+  try {
+    if (!message.request_id || message.model_name !== modelName) throw new Error('Avatar target mismatch');
+    const adapter = (window as any).getLAppAdapter?.();
+    const model = adapter?.getModel();
+    if (!model?._modelSetting) throw new Error('Avatar is not loaded');
+    if (message.kind === 'expression') {
+      const value = message.value;
+      const name = typeof value === 'number' ? adapter.getExpressionName(value) : value;
+      if (typeof name !== 'string' || !model._expressions.getValue(name)) throw new Error('Expression unavailable');
+      adapter.setExpression(name);
+      respond('executed');
+    } else if (message.kind === 'motion') {
+      const value = message.value;
+      if (!value || typeof value !== 'object' || !Number.isInteger(value.index) || value.index < 0
+          || value.index >= adapter.getMotionCount(value.group)) throw new Error('Motion unavailable');
+      const handle = adapter.startMotion(value.group, value.index, 3);
+      // Looping model motions never finish. Confirm that the SDK actually started this entry.
+      requestAnimationFrame(() => {
+        const entry = model._motionManager.getCubismMotionQueueEntry(handle);
+        respond(entry?.isStarted() ? 'executed' : 'unknown');
+      });
+    } else {
+      throw new Error('Unknown avatar action');
+    }
+  } catch {
+    respond('failed');
+  }
+}
