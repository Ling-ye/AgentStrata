{
  "name": "agentstrata-live2d-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop companion for the local AgentStrata WSL plugins",
  "author": "Lingye",
  "license": "AGPL-3.0-only",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/resources.cjs",
    "test": "npm run build && node --test test/*.test.cjs",
    "start": "electron .",
    "smoke": "node scripts/smoke.cjs",
    "pack": "npm run build && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "org.agentstrata.live2d",
    "productName": "AgentStrata Live2D",
    "directories": {"output": "release"},
    "files": ["dist/**", "ui/**", "licenses/**", "package.json"],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {"target": ["nsis", "zip"], "icon": "ui/icon.ico", "signExecutable": false},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true},
    "artifactName": "AgentStrata-Live2D-${version}-${arch}.${ext}"
  }
}
