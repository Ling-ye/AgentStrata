# Lingye的AI助手 local private config.
#
# Copy this file to:
#   bots/lingye-copilot-qq/local.env
#
# Fill real values in the copied file. The copied local.env is ignored by git
# and is read directly by the WSL-native provisioning flow.

# LLM credentials. The key prefix MUST match bot.yaml's llm.chat.env_prefix
# (this instance uses CHATCOPILOT_LINGYE). provision-env copies these verbatim
# into the runtime env; a mismatched prefix means the key is never injected.
export CHATCOPILOT_LINGYE_API_KEY="sk-xxxxxxxx"
export CHATCOPILOT_LINGYE_BASE_URL="https://api.deepseek.com"
export CHATCOPILOT_LINGYE_MODEL="deepseek-v4-pro"

# Main DeepSeek turn budget: 50-minute soft limit, 1-hour absolute limit.
export CHATCOPILOT_LINGYE_TIMEOUT="900"
export CHATCOPILOT_LINGYE_MAX_TOOL_ITERATIONS="32"
export CHATCOPILOT_LINGYE_HARD_ITERATION_CAP="96"
export CHATCOPILOT_LINGYE_MAX_TOOL_CALLS="128"
export CHATCOPILOT_LINGYE_TURN_TIMEOUT_SECONDS="3000"
export CHATCOPILOT_LINGYE_HARD_TIMEOUT_SECONDS="3600"
export CHATCOPILOT_LINGYE_STALL_WINDOW_SECONDS="120"

# The fixed Codex executable and instance authentication root are
# required. Run `python -m chatcopilot bot codex-auth login --bot
# bots/lingye-copilot-qq/bot.yaml --lane all` to perform separate device
# authorizations for main (`auth.json`) and worker (`worker/auth.json`).
# Runtime fails closed and never imports or falls back to desktop
# or personal ~/.codex state. Keep credential directories chmod 700 and each
# auth.json chmod 600.
export CHATCOPILOT_CODEX_BIN="$HOME/.local/bin/codex"
export CHATCOPILOT_CODEX_BOT_HOME="$HOME/.config/chatcopilot-codex-bot"
export CHATCOPILOT_CODE_TASK_TIMEOUT_SECONDS="7200"
export CHATCOPILOT_CODE_TASK_MEMORY_MAX_BYTES="3221225472"
export CHATCOPILOT_CODE_TASK_CPU_QUOTA_PERCENT="400"
export CHATCOPILOT_CODE_TASK_TASKS_MAX="256"
export CHATCOPILOT_CODE_TASK_DISK_MAX_BYTES="5368709120"
# Code-task delivery uses a dedicated GitHub token that can read repository
# metadata, push Contents, and create Pull requests. register.sh materializes
# this raw value into a worker-only 0600 token file; it never enters prompts.
# The expected actor is checked through GitHub before clone and delivery. Git
# author/committer remain a distinct, intentionally public automation identity.
export CHATCOPILOT_CODE_TASK_GITHUB_REPOSITORY="Ling-ye/AgentStrata"
export CHATCOPILOT_CODE_TASK_GITHUB_TOKEN=""
export CHATCOPILOT_CODE_TASK_GITHUB_ACTOR="Ling-ye"
export CHATCOPILOT_CODE_TASK_GIT_AUTHOR_NAME="AgentStrata AI Coding Bot"
export CHATCOPILOT_CODE_TASK_GIT_AUTHOR_EMAIL="agentstrata-ai-coding-bot@automation.invalid"

# Optional: override only the research model; key/base URL inherit from chat.
export CHATCOPILOT_RESEARCH_MODEL=""
# Set these only when research uses a different endpoint or credential.
# export CHATCOPILOT_RESEARCH_API_KEY="sk-xxxxxxxx"
# export CHATCOPILOT_RESEARCH_BASE_URL="https://example.com/v1"

# Optional source roots for the platform-neutral codebase capability.
# CHATCOPILOT_CODEBASE_CHATCOPILOT_ROOT defaults to the source BotSpec repo
# when CHATCOPILOT_SOURCE_BOT_SPEC is set by provision-env; keep this override
# only when you want to point at a separate clone.
# export CHATCOPILOT_CODEBASE_CHATCOPILOT_ROOT="$HOME/ChatCopilot"
# Add one env var per extra registered repository in codebases/repositories.yaml.
# export CHATCOPILOT_CODEBASE_TOOL_A_ROOT="$HOME/repos/tool-a"
# export CHATCOPILOT_CODEBASE_UNITY_PROJECT_ROOT="$HOME/repos/unity-project"
# Dedicated clone, task worktree, state, and symbol-index storage.
export CHATCOPILOT_CODEBASE_CACHE_ROOT="$HOME/.chatcopilot-codebases/lingye-copilot-qq"

# Per-instance Gateway. Generate the token with `openssl rand -hex 32`; do not
# reuse QQ_ACCESS_TOKEN because the Gateway and OneBot are separate trust
# boundaries.
export CHATCOPILOT_GATEWAY_PORT="18789"
export CHATCOPILOT_GATEWAY_TOKEN=""
export CHATCOPILOT_GATEWAY_STATE_ROOT="$HOME/.local/state/agentstrata/lingye-copilot-qq/gateway"

# QQ account held by NapCat. Use a dedicated bot account.
export QQ_ACCOUNT="YOUR_BOT_QQ_ID"

# Optional: passwordless re-login. When set, NapCat re-logs in automatically with
# ACCOUNT + this password after the session expires (e.g. container restart),
# instead of forcing a QR scan. First login may still need a captcha / device
# approval. Use the MD5 variant if you prefer not to store the plaintext password.
# Changing this requires recreating the NapCat container (docker rm then start).
export NAPCAT_QUICK_PASSWORD=""
# export NAPCAT_QUICK_PASSWORD_MD5=""

# NapCat/Linux QQ crash guard for Docker/WSL. Keep bypass disabled unless you
# are deliberately debugging NapCat internals; this avoids /opt/QQ/qq 139
# crashes that can fill Windows Temp wsl-crashes with .dmp files.
export NAPCAT_DISABLE_BYPASS="1"
export NAPCAT_DISABLE_MULTI_PROCESS="1"
export NAPCAT_SHM_SIZE="512m"

# NapCat forward WebSocket endpoint used directly by the QQ Channel.
export CHATCOPILOT_QQ_ONEBOT_WS_URL="ws://127.0.0.1:3001"

# Required: 32-128 URL-safe characters. Generate with `openssl rand -hex 32`.
# Paste the same value into NapCat WebUI's forward WebSocket Access Token.
export QQ_ACCESS_TOKEN=""

# Gateway private-chat admission. Empty values deny private chat; an exact "*"
# allows all private senders. Group members can chat by mentioning the bot.
export QQ_ALLOW_FROM="YOUR_QQ_ID"

# Optional target for the platform-level QQ external check. This is not an
# Agent Evaluation input and does not require a second sender account. The
# default check only verifies that the logged-in Bot can read this group's
# metadata. A message is sent only when the operator supplies both explicit CLI
# write flags for that invocation.
export CHATCOPILOT_EXTERNAL_CHECK_QQ_GROUP_ID="YOUR_EXTERNAL_CHECK_GROUP_ID"

# Owner QQ number(s), comma-separated. Only Owner can view or modify any bot
# persona scope. Admitted users may read/append current private/group memory;
# private users clear self, while only Owner can clear a whole group memory.
export CHATCOPILOT_ADD_OWNER_IDS="YOUR_OWNER_QQ_ID"

# Owner-private local Markdown Wiki. This directory may itself be a private Git
# worktree, but AgentStrata never commits or pushes it automatically.
export CHATCOPILOT_WIKI_ROOT="$HOME/chatcopilot-wiki/lingye-copilot-qq"

# Optional host port for NapCat WebUI. Defaults to 6099.
export QQ_WEBUI_PORT="6099"

# Direct web-provider credentials. The current BotSpec enables Tavily as the
# primary provider and keeps SearXNG as the no-key fallback. Provider policy is
# declared under agents.unified_search.providers, not in MCP bindings.
export TAVILY_API_KEY="tvly-xxxxxxxx"
# Fill this only after enabling the reviewed Brave provider in bot.yaml.
export BRAVE_API_KEY=""

# Optional: GitHub remote MCP Authorization header.
# Required only after owner approves the github-readonly MCP proposal.
# Use the complete header value, for example: Bearer github_pat_xxx
export GITHUB_MCP_AUTHORIZATION=""

# Evaluation data are downloaded explicitly and kept outside the repository.
# GAIA additionally requires access approval at its official Hugging Face page
# and hf auth login, or CHATCOPILOT_HF_TOKEN in the private local.env.
export CHATCOPILOT_HF_TOKEN=""
# AgentBench FC: run scripts/prepare_agentbench.py up, then use its output.
export CHATCOPILOT_AGENTBENCH_DATA_PATH=""
export CHATCOPILOT_AGENTBENCH_CONTROLLER_URL=""
export CHATCOPILOT_EVALS_DATA_DIR="~/.cache/agentstrata/evals"
# Optional overrides; leave unset to discover the prepared official cache.
# export CHATCOPILOT_GAIA_DATA_PATH=""
# export CHATCOPILOT_SWEBENCH_DATA_PATH=""

# LLM 测评：通过控制台准备官方固定版本数据；不自动开始模型测评。
# 留空时使用已校验的私有缓存；也可指定相应官方数据路径。
CHATCOPILOT_BFCL_DATA_DIR=
CHATCOPILOT_IFEVAL_DATA_PATH=
# full=官方全量，balanced-100=显式 100 题子集，smoke=少量调试题。
CHATCOPILOT_BFCL_CASE_PROFILE=full
CHATCOPILOT_IFEVAL_CASE_PROFILE=full
