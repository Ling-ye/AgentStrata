id: my-weixin-bot
display_name: 微信助手
gateway:
  protocol_version: 1
  host: 127.0.0.1
  port_env: CHATCOPILOT_GATEWAY_PORT
  token_env: CHATCOPILOT_GATEWAY_TOKEN
  state_root_env: CHATCOPILOT_GATEWAY_STATE_ROOT
channels:
  weixin:
    type: weixin_clawbot
    provider: ilink
    channel_id: weixin
    access_token_env: WEIXIN_BOT_TOKEN
    account_env: WEIXIN_BOT_ID
    user_env: WEIXIN_USER_ID
    endpoint_env: WEIXIN_API_BASE_URL
workspace:
  root_env: CHATCOPILOT_WORKSPACE_ROOT
deploy:
  target: wsl2
  instance_id: my-weixin-bot
  wsl_home: ~/ChatCopilot-my-weixin-bot
  workspace_root: ~/chatcopilot-workspaces/my-weixin-bot
  log_dir: ~/chatcopilot-logs/my-weixin-bot
  env_file: ~/.chatcopilot-my-weixin-bot.env
  project_name: chatcopilot-my-weixin-bot
packaging:
  allowlist: package.allowlist.yaml
agent_profile: agent.yaml
