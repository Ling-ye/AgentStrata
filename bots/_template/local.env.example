# Local private config for a copied bot instance.
#
# Copy this file to:
#   bots/__BOT_ID__/local.env
#
# Fill real values in the copied file. The copied local.env is ignored by git
# but deployment/provision scripts may copy it to WSL for runtime env generation.

export CHATCOPILOT_CHAT_API_KEY="sk-xxxxxxxx"
export CHATCOPILOT_CHAT_BASE_URL="https://litellm.example.com"
export CHATCOPILOT_CHAT_MODEL="openai/gpt-4.1-mini"

# Workspace root used by chat.workspace and chat.user_files.
export CHATCOPILOT_WORKSPACE_ROOT="~/chatcopilot-workspaces/__BOT_ID__"

# Optional legacy read-only repositories for codebase.read.
# Keep registry metadata in codebases/repositories.yaml and machine paths here.
# Source mutation uses context.dev/dev.* or isolated Codex code tasks instead.
# export CHATCOPILOT_CODEBASE_AGENTSTRATA_ROOT="$HOME/AgentStrata"
# export CHATCOPILOT_CODEBASE_TOOL_A_ROOT="$HOME/repos/tool-a"
# export CHATCOPILOT_CODEBASE_CACHE_ROOT="$HOME/.chatcopilot-codebases/__BOT_ID__"

# Optional owner ids, comma-separated. The platform adapter decides id format.
export CHATCOPILOT_ADD_OWNER_IDS=""
export CHATCOPILOT_ADD_OWNER_NAMES=""

# Feishu credentials. Required only for bot.feishu.yaml.template.
export FEISHU_APP_ID="cli_xxxxxxxxxxxxxxxx"
export FEISHU_APP_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# QQ / NapCat settings. Required only for bot.qq.yaml.template.
export QQ_ACCOUNT="YOUR_BOT_QQ_ID"
export QQ_WS_URL="ws://127.0.0.1:3001"
# Required. Generate once with `openssl rand -hex 32`, then paste the same
# value into NapCat WebUI's forward WebSocket Access Token setting.
export QQ_ACCESS_TOKEN=""
export QQ_ALLOW_FROM="YOUR_ALLOWED_QQ_ID"
export QQ_REQUIRE_AT_IN_GROUP="true"
export QQ_AT_PROXY_URL="ws://127.0.0.1:3002"
export QQ_WEBUI_PORT="6099"

# Optional: passwordless NapCat re-login. Prefer the MD5 variant if you do not
# want to store plaintext password.
export NAPCAT_QUICK_PASSWORD=""
# export NAPCAT_QUICK_PASSWORD_MD5=""

# Optional: Tavily MCP web search API key. Required only when mcp/servers.yaml
# enables the Tavily server.
export TAVILY_API_KEY="tvly-xxxxxxxx"

# Optional: GitHub remote MCP Authorization header.
# Required only after owner approves the github-readonly MCP proposal.
# Use the complete header value, for example: Bearer github_pat_xxx
export GITHUB_MCP_AUTHORIZATION=""
