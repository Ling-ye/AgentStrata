# Private configuration: copy to local.env, chmod 600. Bind from Console while stopped.
AGENTSTRATA_LLM_CONFIG=~/.config/agentstrata/llm.json
CHATCOPILOT_GATEWAY_PORT=18790
# Gateway token is generated by the existing private provisioning service.
CHATCOPILOT_GATEWAY_TOKEN=
# Values below are saved together by Console QR binding.
WEIXIN_BOT_TOKEN=
WEIXIN_BOT_ID=
WEIXIN_USER_ID=
WEIXIN_API_BASE_URL=https://ilinkai.weixin.qq.com
CHATCOPILOT_ADD_OWNER_IDS=
# Fill trusted executable and instance-specific authentication paths.
CHATCOPILOT_CODEX_BIN=
CHATCOPILOT_CODEX_BOT_HOME=
CHATCOPILOT_DEV_ROOT=
CHATCOPILOT_WIKI_ROOT=
TAVILY_API_KEY=
