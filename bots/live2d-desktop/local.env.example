# 原生安装通过设置页生成这些私有引用；不要复制旧实例的凭据。
# 手动配置时只填写同目录 local.env，实际路径由独立安装生成。
AGENTSTRATA_LLM_CONFIG="C:\\absolute\\application\\.agentstrata-versions\\llm.json"
CHATCOPILOT_GATEWAY_PORT="18893"
AGENTSTRATA_AVATAR_GATEWAY_TOKEN=""
AGENTSTRATA_AVATAR_OBSERVER_TOKEN=""
AGENTSTRATA_AVATAR_CONTROL_AUTH=""
AGENTSTRATA_AVATAR_MCP_URL="http://127.0.0.1:12495/agentstrata/mcp/"
# 原生 Windows Python；该独立环境须安装锁定的 Windows-MCP。
AGENTSTRATA_WINDOWS_MCP_PYTHON="C:\\absolute\\path\\to\\python.exe"
CHATCOPILOT_SOURCE_URL=""
